# ── Supabase ──────────────────────────────────────────────────────────────
# Project Settings → API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — server-only, NEVER exposed to the client. Used in API routes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Email address(es) that receive new-submission notifications, comma separated
NUTRITIONIST_NOTIFY_EMAIL=you@yourpractice.com

# ── Email (Resend) ───────────────────────────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key
EMAIL_FROM="Your Practice <hello@yourpractice.com>"

# ── Rate limiting (Upstash Redis) — optional but recommended for /api/intake ─
# https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
